# Copie ce fichier en « .env » et remplis les plateformes que tu veux utiliser.
# Une plateforme non configurée reste utilisable comme SOURCE quand c'est possible
# (Deezer, YouTube Music et Apple Music se lisent sans clé ; Spotify demande une clé).

# Adresse de l'application. En local, garde 127.0.0.1 (Spotify refuse « localhost »).
BASE_URL=http://127.0.0.1:8000
# Chaîne aléatoire qui signe le cookie de session (ex : python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=

# --- Spotify : https://developer.spotify.com/dashboard
# URI de redirection à déclarer : http://127.0.0.1:8000/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Deezer : https://developers.deezer.com/myapps
# URI de redirection à déclarer : http://127.0.0.1:8000/auth/deezer/callback
DEEZER_APP_ID=
DEEZER_APP_SECRET=

# --- YouTube Music (Google Cloud, API « YouTube Data API v3 », identifiants OAuth « Application Web »)
# URI de redirection à déclarer : http://127.0.0.1:8000/auth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Apple Music (compte Apple Developer, clé MusicKit .p8)
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
# ...ou directement un jeton développeur déjà généré :
APPLE_DEVELOPER_TOKEN=
# Pays du catalogue par défaut (fr, us, be, ca...)
APPLE_STOREFRONT=fr

# --- Synchronisation automatique
# Dossier où sont enregistrés les connexions et les synchronisations (base SQLite).
DATA_DIR=data
# Mettre 0 pour désactiver les vérifications automatiques (le bouton « Synchroniser maintenant » reste disponible).
SYNC_ENABLED=1
# Toutes les combien de secondes le serveur regarde si une synchronisation est arrivée à échéance.
SYNC_CHECK_SECONDS=60

# Score minimum (0-100) pour accepter une correspondance trouvée par recherche texte.
MATCH_THRESHOLD=70
